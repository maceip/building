{
  "name": "@codeassist/hono-workbench-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Repository-owned persistent Hono application and loopback HTTP acceptance tests",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "5.9.3"
  }
}
