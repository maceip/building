# Copy to .env.production and chmod 600 .env.production before adding passwords.
# Environment variables take precedence over this file when using tools/android-release.py.
# Public defaults come from config/android-release.properties in both Gradle and this helper.
# Override identity/version here only when needed. Existing apps must retain their ID and key.
# ANDROID_APPLICATION_ID=your.application.id
# ANDROID_VERSION_CODE=2
# ANDROID_VERSION_NAME=1.0.1

# Keep the keystore outside the checkout; use an absolute path.
# Google Play upload key. Play App Signing manages the distribution key separately.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=upload
RELEASE_KEY_PASSWORD=

# Values below are embedded in the app. Use only a PUBLIC Supabase publishable/anon key.
# Leave BOTH Supabase values empty to disable the remote store/accounts/analytics backend.
SUPABASE_URL=
SUPABASE_KEY=
# Empty disables challenge submission.
JUDGE_URL=

# Production defaults to ads disabled. Set true only with your own AdMob IDs.
ANDROID_ADS_ENABLED=false
ADMOB_APP_ID=
ADMOB_NATIVE_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
# Empty placement IDs use the shared native unit instead of the upstream account.
ADMOB_NATIVE_UNIT_STORE=
ADMOB_NATIVE_UNIT_STORE_ITEM=
ADMOB_NATIVE_UNIT_PROJECTS=
ADMOB_NATIVE_UNIT_LEARN=
ADMOB_NATIVE_UNIT_CHALLENGE=
ADMOB_NATIVE_UNIT_BUILD_CONSOLE=
ADMOB_NATIVE_UNIT_RUN_RESULT=
ADMOB_NATIVE_UNIT_SDK_MANAGER=
ADMOB_NATIVE_UNIT_SETTINGS=
ADMOB_NATIVE_UNIT_SIDEBAR=

# Optional if ANDROID_HOME or ANDROID_SDK_ROOT is already exported by the build environment.
# ANDROID_HOME=/Users/mac/Library/Android/sdk
